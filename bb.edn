{:paths ["src" "test"]
 :tasks
 {:requires ([babashka.process :as p])

  daemon
  {:doc "Run the resolve daemon on stdio (newline-delimited JSON-RPC)."
   :task (exec 'cljd-resolve.daemon/-main)}

  test:parse
  {:doc "Syntax layer only -- no Dart, no analyzer."
   :task (shell "bb" "test/parse_test.clj")}

  test:registry
  {:doc "The analyzer registry's supervision rules. No Dart."
   :task (shell "bb" "test/registry_test.clj")}

  test:extension
  {:doc "The extension's daemon client and hover rendering (step 3). Node, no Dart."
   :task (shell "node" "test/extension_test.js")}

  test:analyzer
  {:doc "The patched analyzer helper (step 1), against test/fixture. Needs a Dart SDK."
   :task (apply shell "bb" "test/analyzer_test.clj" *command-line-args*)}

  test:resolve
  {:doc "The daemon end to end (step 2), against test/fixture. Needs a Dart SDK."
   :task (apply shell "bb" "test/resolve_test.clj" *command-line-args*)}

  test:flutter
  {:doc "The optional tier: the same two suites against a real Flutter project.
  bb test:flutter /path/to/cljd-project   (or set CLJD_TEST_PROJECT)"
   :task (let [env {:extra-env {"CLJD_TEST_TARGET" "flutter"}}]
           (apply shell env "bb" "test/analyzer_test.clj" *command-line-args*)
           (apply shell env "bb" "test/resolve_test.clj" *command-line-args*))}

  test:material-ui
  {:doc "The same two suites against package:material_ui/material_ui.dart -- the
  standalone Material that Flutter 3.47 split out of the SDK. Needs a project
  that depends on material_ui.
  bb test:material-ui /path/to/project   (or set CLJD_TEST_PROJECT)"
   :task (let [env {:extra-env {"CLJD_TEST_TARGET" "material_ui"}}]
           (apply shell env "bb" "test/analyzer_test.clj" *command-line-args*)
           (apply shell env "bb" "test/resolve_test.clj" *command-line-args*))}

  test
  {:doc "Everything that runs without a Flutter SDK. Suites needing a Dart SDK
  skip when there is none -- set CLJD_TEST_STRICT=1 to make that a failure."
   :depends [test:parse test:registry test:extension test:analyzer test:resolve]}}}
